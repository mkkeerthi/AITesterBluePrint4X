# Comments live on their own lines on purpose: docker compose env_file
# does not strip inline comments, it keeps them as part of the value.

# ---- vector DB (Qdrant) ----
# Local: http://localhost:6333 with no key. Qdrant Cloud: the cluster URL (https://<id>...cloud.qdrant.io:6333) plus its API key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=qabuddy

# ---- embeddings (Ollama, open source) ----
OLLAMA_URL=http://localhost:11434
# qwen3-embedding:0.6b is the lightweight default; runs comfortably on CPU
EMBED_MODEL=qwen3-embedding:0.6b
# 1024 is the 0.6b model's native width (Matryoshka truncation still available via Ollama)
EMBED_DIM=1024

# ---- reranker (cross-encoder, runs inside the API process) ----
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- answer LLM (any OpenAI-compatible endpoint) ----
# groq | ollama | openai
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- retrieval knobs ----
# candidates pulled from each of dense and BM25
PREFETCH_K=40
# fused candidates the cross-encoder re-scores
RERANK_CANDIDATES=24
# sources handed to the LLM
FINAL_K=6
# hard token budget for source text inside the prompt
CONTEXT_TOKENS=3500

# ---- JIRA (REST + JQL sync into data/01_JIRA_Tickets) ----
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=project = VWO ORDER BY updated DESC

# ---- server ----
PORT=8300
